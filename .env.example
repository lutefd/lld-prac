# Existing external Docker network used by your cloudflared container.
CLOUDFLARED_NETWORK=cloudflared
# Exact browser origin, including https:// and any nonstandard port; no trailing slash.
# Multiple origins can be comma-separated.
PRACTICE_ALLOWED_ORIGINS=https://practice.example.com
# Secret used to sign session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL for auth cookies (defaults to the first PRACTICE_ALLOWED_ORIGINS entry).
# BETTER_AUTH_URL=https://practice.example.com
# Set to true after your group has registered to block new accounts.
# PRACTICE_DISABLE_SIGNUP=true
# Absolute Linux host path, mounted at the same path inside the backend.
PRACTICE_RUN_ROOT=/var/lib/workbench/runs
PRACTICE_MAX_WORKSPACES=20
PRACTICE_TEST_CONCURRENCY=2
PRACTICE_TEST_TIMEOUT_MS=60000
PRACTICE_TEST_QUEUE_LIMIT=10
PRACTICE_QUEUE_TIMEOUT_MS=60000
PRACTICE_LSP_IDLE_MS=300000
PRACTICE_WORKSPACE_IDLE_MS=3600000

# Native Java editor support: jdtls must be on PATH, or set an executable path.
# PRACTICE_JAVA_LSP=/path/to/jdtls/bin/jdtls
# Standalone Docker mode uses this prebuilt image (Compose builds it automatically).
# PRACTICE_JAVA_IMAGE=workbench-java-runner:21
