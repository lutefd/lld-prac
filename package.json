{
  "name": "lld-prac",
  "version": "1.0.0",
  "description": "Local low-level design practice with Monaco, language servers, and progressive tests",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node scripts/dev.ts --production",
    "test": "node --test server/*.test.ts shared/*.test.ts",
    "test:e2e": "playwright test",
    "test:lsp": "node --test tests/lsp.integration.test.ts",
    "test:docker": "node scripts/verify-docker.ts",
    "format": "prettier --write src server shared scripts tests *.ts *.json README.md .github"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "express": "^5.3.0",
    "lucide-react": "^1.76.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "pyright": "^1.1.414",
    "typescript": "^6.0.3",
    "typescript-language-server": "^6.1.0",
    "vite": "^8.3.8"
  },
  "private": true
}
